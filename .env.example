# Application & Environment
APP_ENV=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:8000

# PostgreSQL Database Configuration
POSTGRES_DB=appointments_db
POSTGRES_USER=clinic_admin
POSTGRES_PASSWORD=clinic_secure_pass_2026
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://clinic_admin:clinic_secure_pass_2026@database:5432/appointments_db

# Security & RBAC Session Key
JWT_SECRET=clinic_super_secret_key_2026_rbac

# Monitoring & Portals
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
