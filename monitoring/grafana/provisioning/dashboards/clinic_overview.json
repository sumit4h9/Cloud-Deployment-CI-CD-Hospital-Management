  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "API & Traffic Telemetry",
      "type": "row"
    },
    {
      "title": "HTTP Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (method, endpoint)",
          "legendFormat": "{{method}} {{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "HTTP 4xx & 5xx Error Rates",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{http_status=~\"4..\"}[1m]))",
          "legendFormat": "4xx Errors",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{http_status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Errors",
          "refId": "B"
        }
      ]
    },
    {
      "title": "P95 Request Latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Appointment Domain Lifecycle & Concurrency Invariant",
      "type": "row"
    },
    {
      "title": "Appointments Created vs Completed vs Cancelled",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "targets": [
        {
          "expr": "appointments_created_total",
          "legendFormat": "Created Total",
          "refId": "A"
        },
        {
          "expr": "appointments_completed_total",
          "legendFormat": "Completed Total",
          "refId": "B"
        },
        {
          "expr": "appointments_cancelled_total",
          "legendFormat": "Cancelled Total",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Concurrency Conflicts Prevented (Double-Booking Invariant Guard)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 9 },
      "id": 5,
      "targets": [
        {
          "expr": "concurrency_conflicts_prevented_total",
          "legendFormat": "Conflicts Blocked (409)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Active Available Slots",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 9 },
      "id": 6,
      "targets": [
        {
          "expr": "active_available_slots",
          "legendFormat": "Open Bookable Slots",
          "refId": "A"
        }
      ]
    }
